# Local development: copy this file to .env.local and fill in values.
#   cp .env.example .env.local
# Never commit .env.local — it is listed in .gitignore.
#
# Run the site + API locally with: npx vercel dev
# (loads .env.local for serverless functions)

RESEND_API_KEY=

# Optional — overrides the default “to” address in api/contact.js. If this is set to the
# wrong inbox while still on onboarding@resend.dev, sends will fail — remove RESEND_TO or
# use your Resend account email until your domain is verified.
# RESEND_TO=your-resend-login@gmail.com
# After domain verification in Resend:
# RESEND_TO=animalconnectionsf@gmail.com
# RESEND_FROM=contact@your-verified-domain.com
